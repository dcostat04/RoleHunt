# Copy to .env for local runs:  set -a && . ./.env && set +a && python -m job_scout --dry-run
# In GitHub Actions these are repository secrets instead.

GEMINI_API_KEY=
# Optional: X API bearer token on a tier with recent search. Twitter/X is skipped without it.
X_BEARER_TOKEN=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
# Gmail: create an App Password (Google Account > Security > 2-Step Verification > App passwords)
SMTP_PASSWORD=
# Comma-separated
EMAIL_TO=you@gmail.com
